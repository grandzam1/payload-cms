# --- Always required ---
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Local (SQLite, no Supabase) ---
DATABASE_URL=file:./.db

# --- Supabase Postgres (switches @payloadcms/db-postgres on) ---
# Local: Session pooler (:5432) — transactions/login work reliably
# Vercel: Transaction pooler (:6543) + ?pgbouncer=true — avoids max-clients on serverless
# Dashboard → Project Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres.crjnpllyjxujnxdxkjfo:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Cloudinary media (preferred when set; disables S3 adapter) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=payload-media

# --- Supabase Storage via S3 adapter (@payloadcms/storage-s3) ---
# Used only when Cloudinary is not configured
# Dashboard → Storage → S3 connection → create access keys
# S3_BUCKET=media
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://crjnpllyjxujnxdxkjfo.storage.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public CDN/object URL base (not the S3 API endpoint)
# S3_PUBLIC_URL=https://crjnpllyjxujnxdxkjfo.supabase.co/storage/v1/object/public/media

# Optional (not required by Payload adapters; useful for other Supabase clients)
# NEXT_PUBLIC_SUPABASE_URL=https://crjnpllyjxujnxdxkjfo.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
