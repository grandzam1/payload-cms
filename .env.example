# --- Always required ---
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Database target (single switch) ---
# local = Windows Postgres on localhost:5432 (default for dev)
# neon  = remote Neon (reads NEON_* below or .env.neon)
DB_TARGET=local

# Local Windows Postgres (WSL reaches Windows via 127.0.0.1)
# Create the database once in pgAdmin or psql: CREATE DATABASE payload;
LOCAL_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/payload

# Neon (optional — usually pulled into .env.neon via: pnpm db:pull-neon)
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# NEON_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Production (Vercel): set DATABASE_URL + DATABASE_URL_UNPOOLED in the Vercel dashboard.
# Vercel injects them automatically when Neon is linked — no DB_TARGET needed there.

# --- Cloudinary media (preferred when set; disables S3 adapter) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=payload-media

# --- Optional S3-compatible storage (only when Cloudinary is not configured) ---
# S3_BUCKET=media
# S3_REGION=eu-central-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# --- Optional admin bootstrap (pnpm db:seed-admin) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# --- Portable DB snapshots (pnpm db:export / db:import / db:pull) ---
# Working snapshot: data/db/latest.sql (gitignored)
# Committed baseline: data/seed/dev.sql (run pnpm db:seed after export)
