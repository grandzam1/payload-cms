{
  "name": "payload-cms",
  "version": "1.0.0",
  "description": "Beginner-friendly Payload CMS 3 content studio (local Postgres + Neon on Vercel)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:status": "tsx scripts/db-cli.ts status",
    "db:use:local": "tsx scripts/db-cli.ts use local",
    "db:use:neon": "tsx scripts/db-cli.ts use neon",
    "db:test": "tsx scripts/db-cli.ts test",
    "db:pull-neon": "tsx scripts/db-cli.ts pull-neon",
    "db:export": "tsx scripts/db-cli.ts export",
    "db:import": "tsx scripts/db-cli.ts import",
    "db:pull": "tsx scripts/db-cli.ts pull",
    "db:push": "tsx scripts/db-cli.ts push",
    "db:switch:local": "tsx scripts/db-cli.ts switch local",
    "db:switch:neon": "tsx scripts/db-cli.ts switch neon",
    "db:seed": "tsx scripts/db-cli.ts seed",
    "db:seed:import": "tsx scripts/db-cli.ts seed:import",
    "db:snapshot": "tsx scripts/db-cli.ts snapshot",
    "db:migrate": "tsx scripts/with-db.ts migrate",
    "db:migrate:create": "tsx scripts/with-db.ts migrate:create",
    "db:seed-admin": "tsx scripts/create-admin.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.9.5",
    "@payloadcms/db-postgres": "^3.87.0",
    "@payloadcms/db-sqlite": "3.87.0",
    "@payloadcms/db-vercel-postgres": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-s3": "^3.87.0",
    "@payloadcms/ui": "3.87.0",
    "cloudinary": "^2.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.87.0",
    "payload-cloudinary": "^2.3.0",
    "payload-theme": "0.9.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "netlify-cli": "^27.0.1",
    "pg": "^8.22.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vercel": "^58.4.4",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
